# Copy this file to secrets.env (gitignored - never commit the real one) and fill in your own
# values. Both satellite imagery and NOAA historical wind/cloud data are optional - the app
# works fine without them, those specific layers/cards just show a short setup note instead.
#
# See README.md for full sign-up steps for each.

# Weekly hi-res satellite (Sentinel-2 via Copernicus Data Space Ecosystem) - free account.
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_INSTANCE_ID=
# Only change this if your Sentinel Hub configuration's true-color layer has a different name
# than the default:
SH_LAYER_NAME=TRUE_COLOR

# Historical wind/cloud data (NOAA NCEI Climate Data Online) - free token, email-only signup.
NOAA_TOKEN=
